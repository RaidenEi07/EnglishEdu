# ============================================================
#  EnglishEdu – Production Environment Variables
#  Copy to .env.prod and fill in all values before deploying
#  NEVER commit .env.prod to version control
# ============================================================

# ── Domains ─────────────────────────────────────────────────
# Main website domain (frontend + /api)
DOMAIN=your-server-ip-or-domain

# Moodle subdomain
LMS_DOMAIN=your-server-ip-or-domain

# ── Database (PostgreSQL for Spring Boot) ───────────────────
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── Admin account (first-run seed) ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── JWT ─────────────────────────────────────────────────────
# REQUIRED: at least 32 characters, random hex string
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ── MinIO (file storage) ────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret

JPA_DDL_AUTO=validate

# ── Moodle ──────────────────────────────────────────────────
# Admin token from: Moodle → Site Admin → Plugins → Web Services → Manage tokens
MOODLE_TOKEN=

# Must match auth_userkey plugin secret set in Moodle admin settings
# Generate with: openssl rand -hex 32
MOODLE_SSO_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Moodle admin account (used on first install only)
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_moodle_admin_password
MOODLE_ADMIN_EMAIL=admin@yourdomain.com

# ── Email (Gmail example) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# Use Gmail App Password, not your account password
MAIL_PASSWORD=your-gmail-app-password

